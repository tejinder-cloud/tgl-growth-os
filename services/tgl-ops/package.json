{
  "name": "tgl-ops",
  "version": "1.0.0",
  "description": "The Growth Lab Ops Slack service & approval webhook",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsx src/scripts/sync-assets.ts && tsc && (cp -r src/assets dist/assets 2>/dev/null || true)",
    "sync-assets": "tsx src/scripts/sync-assets.ts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx src/test-task-p07.ts && tsx src/test-intake-qa.ts && tsx src/test-day17.ts && tsx src/test-day19.ts && tsx src/test-day22.ts && tsx src/test-fixes.ts && tsx src/test-plan-status-and-no-emojis.ts && tsx src/test-day08-aeo.ts && tsx src/test-revenue-blockers.ts",
    "test:revenue": "tsx src/test-revenue-blockers.ts",
    "test:plan-status": "tsx src/test-plan-status-and-no-emojis.ts",
    "test:intake-qa": "tsx src/test-intake-qa.ts",
    "test:plumbing": "tsx src/test-plumbing.ts",
    "test:day05": "tsx src/test-day05.ts",
    "test:day07": "tsx src/test-day07.ts",
    "test:day08": "tsx src/test-day08.ts",
    "test:day08-aeo": "tsx src/test-day08-aeo.ts",
    "audit:short-form": "node dist/scripts/run-short-form-audit.js",
    "rescore": "tsx src/scripts/rescore-today.ts",
    "sync-labels": "tsx src/scripts/sync-labels.ts",
    "test:day17": "tsx src/test-day17.ts",
    "citations": "tsx src/scripts/run-citations.ts",
    "reopen-review": "tsx src/scripts/reopen-review.ts",
    "test:day19": "tsx src/test-day19.ts",
    "test:day22": "tsx src/test-day22.ts",
    "check-pr": "tsx src/ci/check-pr-description.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@octokit/rest": "^21.0.2",
    "@slack/web-api": "^7.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "marked": "^12.0.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.20.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
