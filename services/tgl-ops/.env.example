# TGL Ops Service Configuration

# Service Port
PORT=3000

# Slack App Credentials (from api.slack.com/apps -> Basic Information & OAuth)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# GitHub Integration (Personal Access Token with 'repo' scope)
GITHUB_TOKEN=ghp_your_github_token
GITHUB_OWNER=tejinder-cloud
GITHUB_REPO_NAME=tgl-growth-os

# Slack Channel IDs (or channel names e.g. #approvals, #standup, #alerts)
APPROVALS_CHANNEL_ID=C0XXXXXXXXX
STANDUP_CHANNEL_ID=C0YYYYYYYYY
ALERTS_CHANNEL_ID=C0ZZZZZZZZZ
ARCHITECT_CHANNEL_ID=C0AAAAAAAAA

# Operational Timezone
TIMEZONE=Asia/Kolkata

# Anthropic LLM (Model must not be hard-coded; prices in USD per MTok)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_PRICE_IN=3.00
ANTHROPIC_PRICE_OUT=15.00

# ── AEO Audit Engine / Citation Tracker (agents/aeo-audit-engine) ───────────────
# Each engine runs only when ALL its variables are set; a missing one is reported in #alerts, never defaulted.
# Prices are USD: *_PRICE_IN / *_PRICE_OUT per 1M tokens, *_SEARCH_PRICE_PER_1K per 1,000 web searches/requests.
OPENAI_API_KEY=
AEO_OPENAI_MODEL=
AEO_OPENAI_PRICE_IN=
AEO_OPENAI_PRICE_OUT=
AEO_OPENAI_SEARCH_PRICE_PER_1K=
# Web searches ChatGPT may run per question (default 1; each costs AEO_OPENAI_SEARCH_PRICE_PER_1K / 1000)
# AEO_OPENAI_MAX_SEARCHES=1
GEMINI_API_KEY=
AEO_GEMINI_MODEL=
AEO_GEMINI_PRICE_IN=
AEO_GEMINI_PRICE_OUT=
AEO_GEMINI_SEARCH_PRICE_PER_1K=
# Free grounding searches per calendar month (Gemini 3 models: 5,000, ai.google.dev pricing). Unset = 0 → every search charged (upper bound).
AEO_GEMINI_FREE_SEARCHES_PER_MONTH=5000
PERPLEXITY_API_KEY=
# Perplexity Agent API (Sonar retired 27 Sep 2026). Set ONE of these. No prices needed: each response reports its own cost.
AEO_PERPLEXITY_EFFORT=fast
# AEO_PERPLEXITY_MODEL=provider/model
# Optional endpoint overrides: AEO_OPENAI_URL, AEO_GEMINI_URL, AEO_PERPLEXITY_URL
# ₹ per $1, used to write usage_costs.amount_inr (the cost-per-brand number, SPEC §14). Update when it moves.
USD_INR_RATE=

# ── Outreach Sequencer (agents/outreach-sequencer, SKILL.md Playbooks A-D) ──────
# Dry run is the default: with OUTREACH_LIVE unset or anything other than exactly 1, the worker builds the
# audit, PDF and messages and records them as dry_run, and sends nothing to any prospect.
OUTREACH_LIVE=0
# Sends per day across all touches (default 20). Due touches beyond the cap roll to the next day.
OUTREACH_DAILY_SEND_CAP=20
# GoHighLevel API
GHL_API_KEY=
GHL_LOCATION_ID=
# Optional overrides
# GHL_API_BASE=
# GHL_API_VERSION=
# GHL_EMAIL_FROM=
# Shared secret GHL sends in the x-outreach-secret header to POST /outreach/ghl-reply.
# Unset means the route returns 503 and refuses every request (fails closed).
OUTREACH_WEBHOOK_SECRET=
# Supabase Storage bucket for per-prospect one-pager PDFs (default audit-onepagers). Signed URLs last 7 days.
# OUTREACH_ONEPAGER_BUCKET=audit-onepagers
# Slack channel for Sales Desk reply routing (default #revenue)
# SALES_DESK_CHANNEL_ID=#revenue
# Route Protection Secret for POST /audit/short-form and GET /audit/channels (X-TGL-Secret header)
AUDIT_ROUTE_SECRET=

# --- Finance (plan Day 13) ---
# Shared secret for /finance/* routes (GHL deal-Won workflow webhook sends it as header x-finance-secret). Unset = routes return 401.
FINANCE_WEBHOOK_SECRET=
# Provider writes happen only when 1. Unset = dry run (invoice is built and returned, nothing is created).
FINANCE_LIVE=
# razorpay or zoho
FINANCE_INVOICE_PROVIDER=razorpay
# Architect / CA to confirm each of these. Missing values HOLD invoicing; nothing is assumed.
FINANCE_SUPPLIER_NAME=
FINANCE_SUPPLIER_GSTIN=
FINANCE_SUPPLIER_STATE_CODE=
FINANCE_SAC_CODE=
FINANCE_GST_RATE=
# exclusive or inclusive: whether the GHL deal value already contains GST
FINANCE_AMOUNT_MODE=
FINANCE_PAYMENT_TERMS_DAYS=7
# LUT ARN for the current financial year (export of services only)
FINANCE_LUT_NUMBER=
# Where the ledger JSONL files are written. Default finance/ledger under the working directory.
FINANCE_LEDGER_DIR=
# Razorpay Invoices API (RAZORPAY_WEBHOOK_SECRET is shared with /billing/razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Zoho Books (India data centre by default)
ZOHO_BOOKS_API_BASE=https://www.zohoapis.in/books/v3
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_ACCESS_TOKEN=
ZOHO_TAX_ID_INTRA=
ZOHO_TAX_ID_INTER=

# --- Finance: tax configuration (issue #141). All tax values live here, none in code. ---
# The invoice generator refuses to render when GST_RATE, the SAC for the deal, TGL_GSTIN, or (for an export) LUT_NUMBER is missing.
# SAC codes and the rate are to be confirmed by the Architect's CA before the first live invoice.
GST_RATE=18
# Software subscription (Track)
SAC_TRACK=997331
# Managed AEO and AI Automation services
SAC_SERVICES=998314
# TGL's GSTIN. The supplier state is taken from its first two digits unless FINANCE_SUPPLIER_STATE_CODE is set (it must then match).
TGL_GSTIN=
# Letter of Undertaking number, required only to render an export invoice at 0 percent.
LUT_NUMBER=
