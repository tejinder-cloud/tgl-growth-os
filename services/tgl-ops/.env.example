# TGL Ops Service Configuration

# Service Port
PORT=3000

# Slack App Credentials (from api.slack.com/apps -> Basic Information & OAuth)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# GitHub Integration (Personal Access Token with 'repo' scope)
GITHUB_TOKEN=ghp_your_github_token
GITHUB_OWNER=tejinder-cloud
GITHUB_REPO_NAME=tgl-growth-os

# Slack Channel IDs (or channel names e.g. #approvals, #standup, #alerts)
APPROVALS_CHANNEL_ID=C0XXXXXXXXX
STANDUP_CHANNEL_ID=C0YYYYYYYYY
ALERTS_CHANNEL_ID=C0ZZZZZZZZZ
ARCHITECT_CHANNEL_ID=C0AAAAAAAAA

# Operational Timezone
TIMEZONE=Asia/Kolkata

# Anthropic LLM (Model must not be hard-coded; prices in USD per MTok)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_PRICE_IN=3.00
ANTHROPIC_PRICE_OUT=15.00
