{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "TGL Theme",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "palette": [
        {
          "name": "BG: cream",
          "slug": "cream",
          "color": "#F5F0E8"
        },
        {
          "name": "BG: cream deep",
          "slug": "cream-deep",
          "color": "#EDE8DD"
        },
        {
          "name": "BG: card",
          "slug": "card",
          "color": "#F0EBE2"
        },
        {
          "name": "BG: card hover",
          "slug": "card-hover",
          "color": "#EAE4D9"
        },
        {
          "name": "BG: ink",
          "slug": "ink",
          "color": "#2C2118"
        },
        {
          "name": "BG: ink card",
          "slug": "ink-card",
          "color": "#3A3028"
        },
        {
          "name": "TEXT: primary",
          "slug": "primary",
          "color": "#2C2118"
        },
        {
          "name": "TEXT: secondary",
          "slug": "secondary",
          "color": "#6B625B"
        },
        {
          "name": "TEXT: on dark",
          "slug": "on-dark",
          "color": "#F5F0E8"
        },
        {
          "name": "ACCENT: terracotta",
          "slug": "terracotta",
          "color": "#C75B3B"
        },
        {
          "name": "ACCENT: coral",
          "slug": "coral",
          "color": "#E8846B"
        },
        {
          "name": "ACCENT: green",
          "slug": "green",
          "color": "#7BA668"
        },
        {
          "name": "ACCENT: amber",
          "slug": "amber",
          "color": "#E8B44C"
        },
        {
          "name": "ACCENT: teal",
          "slug": "teal",
          "color": "#4A9B8E"
        },
        {
          "name": "LINE: hairline",
          "slug": "hairline",
          "color": "#DDD6CA"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": true,
      "fontFamilies": [
        {
          "name": "Display (Fraunces)",
          "slug": "display",
          "fontFamily": "'Fraunces', Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Fraunces",
              "fontStyle": "normal",
              "fontWeight": "600 800",
              "src": [
                "file:./assets/fonts/fraunces-latin-normal.woff2"
              ]
            },
            {
              "fontFamily": "Fraunces",
              "fontStyle": "italic",
              "fontWeight": "600 800",
              "src": [
                "file:./assets/fonts/fraunces-latin-italic.woff2"
              ]
            }
          ]
        },
        {
          "name": "Body (DM Sans)",
          "slug": "body",
          "fontFamily": "'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "src": [
                "file:./assets/fonts/dm-sans-latin.woff2"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "DISPLAY-XL",
          "slug": "display-xl",
          "size": "clamp(2.4rem, 6.5vw, 4.8rem)"
        },
        {
          "name": "DISPLAY-L",
          "slug": "display-l",
          "size": "clamp(1.8rem, 3.5vw, 3rem)"
        },
        {
          "name": "HEADING-M",
          "slug": "heading-m",
          "size": "clamp(1.15rem, 2vw, 1.4rem)"
        },
        {
          "name": "STAT",
          "slug": "stat",
          "size": "clamp(2rem, 3.5vw, 3rem)"
        },
        {
          "name": "BODY-L",
          "slug": "body-l",
          "size": "clamp(1rem, 1.6vw, 1.15rem)"
        },
        {
          "name": "BODY",
          "slug": "body",
          "size": "clamp(0.95rem, 1.3vw, 1.05rem)"
        },
        {
          "name": "SMALL",
          "slug": "small",
          "size": "14px"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream, #F5F0E8)",
      "text": "var(--wp--preset--color--text-primary, #2C2118)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "clamp(0.95rem, 1.3vw, 1.05rem)",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.12"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary, #2C2118)"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary, #2C2118)"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        },
        "color": {
          "text": "var(--wp--preset--color--text-primary, #2C2118)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--terracotta, #C75B3B)",
          "text": "var(--wp--preset--color--cream, #F5F0E8)"
        },
        "border": {
          "radius": "100px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontWeight": "600",
          "fontSize": "15px"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "36px",
            "right": "36px"
          }
        }
      },
      "link": {
        "typography": {
          "textDecoration": "none"
        },
        "color": {
          "text": "inherit"
        }
      }
    }
  }
}